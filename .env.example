# Names only. Real values live in Vercel → Project → Settings → Environment Variables.
# Local development: `vercel env pull .env.local`, then add the local-only values.

# Neon (set automatically by the Vercel ↔ Neon integration)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Admin sign-in (GitHub OAuth App)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub logins allowed into /admin, comma separated
ADMIN_GITHUB_LOGINS=
# 32+ random characters, signs the admin session cookie
SESSION_SECRET=

# Public address used in canonical URLs, sitemap and structured data
NEXT_PUBLIC_SITE_URL=

# Search console ownership tags (content value only)
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
